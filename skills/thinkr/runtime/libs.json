   "global": "Motion"
  },
  "vgpu": {
   "pkg": "vgpu",
   "version": "0.6.0",
   "url": "https://cdn.jsdelivr.net/npm/vgpu@{v}/+esm",
   "deps": [
    "vgpu-prepare"
   ],
   "modules": [
    "https://cdn.jsdelivr.net/npm/vgpu@0.6.0/+esm",
    "https://cdn.jsdelivr.net/npm/@vgpu/core@0.6.0/+esm",
    "https://cdn.jsdelivr.net/npm/@vgpu/wgsl@0.6.0/+esm"
   ]
  },
  "vgpu-prepare": {
   "pkg": "@vgpu/wgsl",
   "version": "0.6.0",
   "url": "https://cdn.jsdelivr.net/npm/@vgpu/wgsl@{v}/prepare/+esm",
   "modules": [
    "https://cdn.jsdelivr.net/npm/@vgpu/wgsl@0.6.0/prepare/+esm"
   ]
  },
  "d3": {
   "pkg": "d3",
   "version": "7.9.0",
